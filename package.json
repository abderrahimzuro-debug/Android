{
  "name": "mathflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MathFlow — an offline-first, bilingual math-solving PWA with a local symbolic engine, interactive graphs and secure OCR proxy.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "preview": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build": "npm run build && vitest run && node scripts/check-build.mjs && node scripts/browser-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@capacitor/core": "7.6.9",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/stix-two-math": "^5.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/cli": "7.6.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
