# ---------------------------------------------------------------------------
# MathFlow server configuration (copy to .env — NEVER commit the real .env)
# The browser never receives any of these values. They are read only by
# server/*.mjs at process start.
# ---------------------------------------------------------------------------

PORT=3000
HOST=0.0.0.0

# --- OCR provider: "mathpix" (default) or "custom" --------------------------
OCR_PROVIDER=mathpix

# Mathpix: create an account at https://mathpix.com/ocr, then copy the App ID
# and App Key from your dashboard. Both are required for scanning to work.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Optional override of the Mathpix endpoint (useful for proxies/enterprise).
# OCR_ENDPOINT=https://api.mathpix.com/v3/text

# --- Custom provider contract ----------------------------------------------
# Set OCR_PROVIDER=custom to use your own or a self-hosted LaTeX OCR service.
# The server POSTs JSON to OCR_ENDPOINT with header
#   Authorization: Bearer <OCR_API_KEY>
# and body:
#   { "image": "data:image/jpeg;base64,...", "formats": ["latex"] }
# It expects a 200 JSON response:
#   { "latex": "\\\\frac{1}{2} + x^2 = 0", "confidence": 0.93 }
# `confidence` is optional and must be 0..1 (or 0..100).
# http:// is only allowed for localhost/127.0.0.1; otherwise use https.
# OCR_ENDPOINT=http://127.0.0.1:8501/ocr
# OCR_API_KEY=

# --- Limits -----------------------------------------------------------------
OCR_TIMEOUT_MS=25000
OCR_MAX_IMAGE_BYTES=8388608
OCR_RATE_LIMIT=20
OCR_RATE_WINDOW_MS=600000
